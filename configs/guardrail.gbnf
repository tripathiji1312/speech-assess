# llama.cpp GBNF grammar for the claim-support verifier output.
# Forces a well-formed JSON: {"issues": [...], "summary": "ok"|"issues_found"}
# Usage: llama-cli -m model.gguf --grammar-file configs/guardrail.gbnf

root     ::= "{" ws "\"issues\"" ws ":" ws issues ws "," ws "\"summary\"" ws ":" ws summary ws "}"
issues   ::= "[" ws "]" | "[" ws issue (ws "," ws issue)* ws "]"
issue    ::= "{" ws "\"field\"" ws ":" ws string
           ws "," ws "\"claim\"" ws ":" ws string
           ws "," ws "\"problem\"" ws ":" ws problem
           ws "," ws "\"severity\"" ws ":" ws severity
           ws "," ws "\"evidence\"" ws ":" ws string ws "}"
string   ::= "\"" ([^"\\] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]))* "\""
severity ::= "\"low\"" | "\"medium\"" | "\"high\""
problem  ::= "\"not in transcript\"" | "\"contradicts transcript\"" | "\"missing from draft\""
summary  ::= "\"ok\"" | "\"issues_found\""
ws       ::= [ \t\n]*
